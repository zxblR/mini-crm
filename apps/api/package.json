{
  "name": "@mini-crm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @mini-crm/shared build && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@mini-crm/shared": "workspace:*",
    "@nestjs/common": "11.0.11",
    "@nestjs/core": "11.0.11",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.0.11",
    "@prisma/client": "6.5.0",
    "bullmq": "5.41.5",
    "ioredis": "5.4.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.5",
    "@nestjs/schematics": "11.0.2",
    "@nestjs/testing": "11.0.11",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "jest": "29.7.0",
    "prisma": "6.5.0",
    "ts-jest": "29.2.6"
  }
}
