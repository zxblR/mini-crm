generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  admin
  sales
  viewer

  @@map("role_code")
}

enum FollowUpType {
  call
  wechat
  email
  meeting
  other

  @@map("follow_up_type")
}

enum TaskStatus {
  pending
  completed
  cancelled

  @@map("task_status")
}

enum ImportJobStatus {
  queued
  running
  completed
  failed

  @@map("import_job_status")
}

model Organization {
  id            String          @id @default(uuid()) @db.Uuid
  name          String          @db.VarChar(120)
  slug          String          @unique @db.VarChar(80)
  timezone      String          @default("Asia/Shanghai") @db.VarChar(64)
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  users         User[]
  stages        PipelineStage[]
  leads         Lead[]
  tags          Tag[]
  followUps     FollowUp[]
  tasks         Task[]
  auditLogs     AuditLog[]
  importJobs    ImportJob[]
  refreshTokens RefreshToken[]

  @@map("organizations")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  name            String         @db.VarChar(80)
  email           String?        @db.VarChar(254)
  normalizedEmail String?        @map("normalized_email") @db.VarChar(254)
  phone           String?        @db.VarChar(32)
  normalizedPhone String?        @map("normalized_phone") @db.VarChar(32)
  passwordHash    String         @map("password_hash") @db.VarChar(255)
  isActive        Boolean        @default(true) @map("is_active")
  lastLoginAt     DateTime?      @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles           UserRole[]
  ownedLeads      Lead[]         @relation("LeadOwner")
  createdLeads    Lead[]         @relation("LeadCreator")
  stageChanges    StageHistory[]
  followUps       FollowUp[]
  tasks           Task[]         @relation("TaskAssignee")
  createdTasks    Task[]         @relation("TaskCreator")
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  importJobs      ImportJob[]

  @@unique([organizationId, normalizedEmail], map: "users_org_email_unique")
  @@unique([organizationId, normalizedPhone], map: "users_org_phone_unique")
  @@index([organizationId, isActive])
  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  code      RoleCode
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
  @@map("user_roles")
}

model RefreshToken {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  tokenHash      String       @unique @map("token_hash") @db.VarChar(128)
  familyId       String       @map("family_id") @db.Uuid
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(3)
  replacedById   String?      @map("replaced_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(3)
  ipAddress      String?      @map("ip_address") @db.VarChar(64)
  userAgent      String?      @map("user_agent") @db.VarChar(255)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PipelineStage {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  code           String         @db.VarChar(40)
  name           String         @db.VarChar(60)
  color          String         @default("#64748B") @db.VarChar(7)
  sortOrder      Int            @map("sort_order")
  isDefault      Boolean        @default(false) @map("is_default")
  isWon          Boolean        @default(false) @map("is_won")
  isLost         Boolean        @default(false) @map("is_lost")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  leads          Lead[]
  fromHistory    StageHistory[] @relation("FromStage")
  toHistory      StageHistory[] @relation("ToStage")

  @@unique([organizationId, code])
  @@unique([organizationId, sortOrder])
  @@index([organizationId, isActive, sortOrder])
  @@map("pipeline_stages")
}

model Lead {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  name            String?        @db.VarChar(100)
  company         String?        @db.VarChar(160)
  phone           String?        @db.VarChar(32)
  normalizedPhone String?        @map("normalized_phone") @db.VarChar(32)
  email           String?        @db.VarChar(254)
  normalizedEmail String?        @map("normalized_email") @db.VarChar(254)
  source          String         @db.VarChar(60)
  industry        String?        @db.VarChar(80)
  region          String?        @db.VarChar(100)
  notes           String?        @db.Text
  stageId         String         @map("stage_id") @db.Uuid
  ownerId         String?        @map("owner_id") @db.Uuid
  createdById     String         @map("created_by_id") @db.Uuid
  nextFollowUpAt  DateTime?      @map("next_follow_up_at") @db.Timestamptz(3)
  archivedAt      DateTime?      @map("archived_at") @db.Timestamptz(3)
  wonAt           DateTime?      @map("won_at") @db.Timestamptz(3)
  lostAt          DateTime?      @map("lost_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stage           PipelineStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner           User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy       User           @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tags            LeadTag[]
  stageHistory    StageHistory[]
  followUps       FollowUp[]
  tasks           Task[]

  @@index([organizationId, archivedAt, updatedAt])
  @@index([organizationId, ownerId, archivedAt])
  @@index([organizationId, stageId, archivedAt])
  @@index([organizationId, source, createdAt])
  @@index([organizationId, normalizedEmail])
  @@index([organizationId, normalizedPhone])
  @@map("leads")
}

model Tag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(40)
  normalizedName String       @map("normalized_name") @db.VarChar(40)
  color          String       @default("#64748B") @db.VarChar(7)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  leads          LeadTag[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId, name])
  @@map("tags")
}

model LeadTag {
  leadId String @map("lead_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags")
}

model StageHistory {
  id          String         @id @default(uuid()) @db.Uuid
  leadId      String         @map("lead_id") @db.Uuid
  fromStageId String?        @map("from_stage_id") @db.Uuid
  toStageId   String         @map("to_stage_id") @db.Uuid
  actorId     String         @map("actor_id") @db.Uuid
  note        String?        @db.VarChar(500)
  outcomeNote String?        @map("outcome_note") @db.VarChar(500)
  lostReason  String?        @map("lost_reason") @db.VarChar(200)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage   PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id], onDelete: Restrict)
  toStage     PipelineStage  @relation("ToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  actor       User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@map("stage_history")
}

model FollowUp {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  leadId         String       @map("lead_id") @db.Uuid
  createdById    String       @map("created_by_id") @db.Uuid
  type           FollowUpType
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  summary        String       @db.VarChar(500)
  result         String?      @db.VarChar(1000)
  nextStepAt     DateTime?    @map("next_step_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  task           Task?

  @@index([organizationId, leadId, deletedAt, occurredAt])
  @@map("follow_ups")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  leadId         String       @map("lead_id") @db.Uuid
  followUpId     String?      @unique @map("follow_up_id") @db.Uuid
  assigneeId     String       @map("assignee_id") @db.Uuid
  createdById    String       @map("created_by_id") @db.Uuid
  title          String       @db.VarChar(200)
  dueAt          DateTime     @map("due_at") @db.Timestamptz(3)
  status         TaskStatus   @default(pending)
  resolutionNote String?      @map("resolution_note") @db.VarChar(500)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)
  cancelledAt    DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  reminderSentAt DateTime?    @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  followUp       FollowUp?    @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  assignee       User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy      User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, assigneeId, status, dueAt])
  @@index([organizationId, leadId, status])
  @@map("tasks")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  action         String       @db.VarChar(80)
  resourceType   String       @map("resource_type") @db.VarChar(60)
  resourceId     String?      @map("resource_id") @db.Uuid
  requestId      String?      @map("request_id") @db.VarChar(80)
  ipAddress      String?      @map("ip_address") @db.VarChar(64)
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, actorId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
}

model ImportJob {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  createdById    String          @map("created_by_id") @db.Uuid
  type           String          @default("lead_import") @db.VarChar(40)
  status         ImportJobStatus @default(queued)
  fileName       String          @map("file_name") @db.VarChar(255)
  storageKey     String          @map("storage_key") @db.VarChar(500)
  processed      Int             @default(0)
  succeeded      Int             @default(0)
  failed         Int             @default(0)
  errorFileUrl   String?         @map("error_file_url") @db.VarChar(500)
  errorMessage   String?         @map("error_message") @db.VarChar(500)
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@map("import_jobs")
}
