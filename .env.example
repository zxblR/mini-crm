NODE_ENV=development

POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_password
POSTGRES_DB=mini_crm
POSTGRES_PORT=55432
DATABASE_URL=postgresql://crm:crm_local_password@localhost:55432/mini_crm?schema=public
JAVA_DATABASE_URL=jdbc:postgresql://localhost:55432/mini_crm

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

WEB_PORT=8080
VITE_API_BASE_URL=/api/v1

AI_SERVICE_TOKEN=replace-with-a-long-random-internal-token
AI_SERVICE_URL=http://localhost:8000
AI_CONNECT_TIMEOUT_MS=2000
AI_READ_TIMEOUT_MS=8000
AI_TOTAL_BUDGET_MS=10000

# Compose defaults to the internal development mock. Set a real OpenAI-compatible
# endpoint and key to use DeepSeek or another provider.
LLM_BASE_URL=http://mock-llm:9000
LLM_API_KEY=mock-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=768

# Migrations always run. Seed is opt-in and intended only for local demos.
SEED_ON_START=false

JWT_ACCESS_SECRET=replace-with-a-long-development-secret
JWT_ACCESS_EXPIRATION_SECONDS=900
IMPORT_STORAGE_DIR=./data/imports
